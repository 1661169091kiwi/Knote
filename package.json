{
  "name": "knote",
  "private": true,
  "version": "1.1.52",
  "description": "Knote — 类飞书的 Markdown 笔记应用（内置 AI 助手）",
  "author": "KV",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app:dev": "electron .",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux",
    "android:assets": "capacitor-assets generate --android --assetPath assets --iconBackgroundColor \"#ffffff\" --iconBackgroundColorDark \"#ffffff\" --splashBackgroundColor \"#ffffff\" --splashBackgroundColorDark \"#ffffff\" && node scripts/verify-android-assets.mjs",
    "cap:sync": "cap sync android && npm run android:assets && node scripts/set-android-version.mjs && node scripts/configure-android-signing.mjs && node scripts/fix-android-java.mjs",
    "dist:apk:debug": "vite build && npm run cap:sync && cd android && gradlew.bat clean assembleDebug --no-daemon",
    "dist:apk": "vite build && npm run cap:sync && node scripts/configure-android-signing.mjs --require-release-secrets && cd android && gradlew.bat clean assembleRelease --no-daemon",
    "test:retention": "node --test scripts/document-retention.adversarial.test.cjs scripts/snapshot-indexeddb.adversarial.test.mjs",
    "test:agent": "node --test scripts/agent-context-memory.adversarial.test.mjs scripts/agent-execution-chain.adversarial.test.mjs scripts/agent-execution-ledger.adversarial.test.mjs scripts/agent-event-store.adversarial.test.mjs scripts/agent-hydration.adversarial.test.mjs scripts/agent-recovery-transaction.adversarial.test.mjs scripts/agent-recovery.adversarial.test.mjs scripts/agent-review.adversarial.test.mjs scripts/agent-source-continuation.adversarial.test.mjs scripts/agent-state-store.adversarial.test.mjs scripts/agent-surface.adversarial.test.mjs scripts/agent-tool-output-store.adversarial.test.mjs scripts/agent-tool-protocol.adversarial.test.mjs scripts/agent-workspace.adversarial.test.mjs scripts/agent-resource-runtime.adversarial.test.mjs scripts/agent-batch.adversarial.test.mjs scripts/browser-workspace-identity.adversarial.test.mjs scripts/agent-search-config.adversarial.test.mjs scripts/agent-search-scheduler.adversarial.test.mjs scripts/web-search-aggregation.adversarial.test.mjs scripts/academic-search.adversarial.test.mjs scripts/agent-provider-transport.adversarial.test.mjs",
    "test:image": "node --test scripts/image-alignment.adversarial.test.mjs scripts/image-reference.adversarial.test.mjs scripts/image-path-mapping.adversarial.test.mjs",
    "test:paste": "node --test scripts/markdown-paste.adversarial.test.mjs",
    "test:installer": "node --test scripts/installer-association.adversarial.test.mjs",
    "test:installer:windows": "node scripts/installer-association.windows.integration.mjs",
    "test:tab-buffer": "node --test electron/tab-buffer-store.test.cjs scripts/tab-buffer-integration.adversarial.test.mjs scripts/document-metrics.adversarial.test.mjs scripts/large-source-draft.adversarial.test.mjs scripts/large-document-policy.adversarial.test.mjs",
    "test:crash": "node --test electron/crash-diagnostics.test.cjs electron/main-lifecycle.test.cjs electron/quit-cleanup.test.cjs electron/pdf-env-config.test.cjs electron/child-output-decode.test.cjs",
    "test:pdf": "node --test scripts/pdf-delivery.adversarial.test.mjs",
    "test:sidebar": "node --test scripts/sidebar-scroll.adversarial.test.mjs",
    "test:boundary": "node --test electron/agent-sandbox-service.test.cjs electron/agent-command-runner.test.cjs electron/agent-download-resume-store.test.cjs electron/file-stat-time.test.cjs electron/open-target-capability.test.cjs electron/public-url-policy.test.cjs electron/web-download-broker.test.cjs electron/workspace-boundary.test.cjs electron/fs-mutation-coordinator.test.cjs scripts/desktop-fs-stream.adversarial.test.mjs scripts/file-lifecycle.adversarial.test.mjs scripts/local-file-links.adversarial.test.mjs",
    "test:agent-sandbox": "node --test electron/agent-sandbox-service.test.cjs",
    "test:agent-sandbox-electron": "node --test --test-concurrency=1 scripts/agent-sandbox.e2e.test.mjs",
    "test:sandbox-broker": "node scripts/windows-sandbox-broker.test.cjs",
    "test:native": "node --test scripts/native-fs.adversarial.test.mjs scripts/saf-fs.adversarial.test.mjs && npm run test:sandbox-broker",
    "test:editor-native": "npm run build && node --test --test-concurrency=1 scripts/rich-editor-native.e2e.test.mjs",
    "test:electron-ui": "npm run build && node --test --test-concurrency=1 scripts/electron-ui.e2e.test.mjs",
    "test:android-release": "node --test scripts/android-release.adversarial.test.mjs",
    "test": "npm run test:retention && npm run test:agent && npm run test:image && npm run test:paste && npm run test:installer && npm run test:tab-buffer && npm run test:crash && npm run test:pdf && npm run test:sidebar && npm run test:boundary && npm run test:native && npm run test:android-release",
    "test:all": "npm test && npm run test:electron-ui && npm run test:editor-native"
  },
  "build": {
    "appId": "com.kv.knote",
    "productName": "Knote",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "displayLanguageSelector": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "Knote",
      "include": "build/installer.nsh",
      "artifactName": "Knote-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "KV",
      "mimeTypes": ["text/markdown", "text/x-markdown"],
      "artifactName": "Knote-${version}.${ext}"
    }
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^28.1.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "punycode": "^2.3.1",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@capacitor/android": "8.2.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.2.0",
    "@capacitor/core": "8.2.0",
    "@capacitor/filesystem": "^8.1.2",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@knote/capacitor-android": "file:native/knote-capacitor-android",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@tiptap/extension-code-block-lowlight": "^2.27.2",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-mathematics": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@tiptap/vue-3": "^2.27.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vscode/markdown-it-katex": "^1.1.2",
    "autoprefixer": "^10.4.24",
    "daisyui": "^5.5.18",
    "dompurify": "^3.3.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-cjk-friendly": "^2.0.3",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^6.1.200",
    "playwright-core": "^1.62.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tiptap-markdown": "^0.8.10",
    "turndown-plugin-gfm": "^1.0.2",
    "vite": "^7.2.4",
    "vue": "^3.5.24"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
